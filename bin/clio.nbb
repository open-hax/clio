#!/usr/bin/env nbb

(ns clio.bin
  (:require [clio.extern.js.process :as process]
            [clio.infra.cli :as cli]))

(try
  (apply cli/-main *command-line-args*)
  (catch :default cause
    (process/write-error!
      (str (ex-message cause) "\n"
           (when-let [data (ex-data cause)] (str (pr-str data) "\n"))))
    (process/exit! 1)))
