;; Consumable Clojure/ClojureScript dependency metadata for @eta-mu/clio.
;;
;; The npm manifest can only declare the package's JavaScript dependencies, so
;; a consumer adding this package's `src` tree to its ClojureScript source
;; paths would otherwise have to guess and pin the Maven libraries the source
;; actually requires. This file is that record, shipped in the npm tarball, and
;; it is the same set the monorepo builds and tests against.
;;
;; Shadow CLJS declares the same dependencies directly; NBB reads nbb.edn.
;; JVM consumers can use this directory directly as a :local/root dependency.
{:paths ["src"]
 :deps {metosin/malli {:mvn/version "0.16.4"}
        borkdude/edamame {:mvn/version "1.6.42"}
        funcool/promesa {:mvn/version "11.0.678"}}
 :aliases {:test {:extra-paths ["test" "scripts"]
                  :main-opts ["-m" "clio.jvm-test-runner"]}}}
